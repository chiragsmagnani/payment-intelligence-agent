# Copy this file to .env and fill in ONE of the keys below.

# Option A — Groq (RECOMMENDED: free, no credit card required, fastest inference)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL_ID=llama-3.3-70b-versatile

# Option B — Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_ID=claude-sonnet-4-5

# Option C — OpenAI
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini

# Optional: force a provider even if multiple keys are set
# ("groq", "anthropic", or "openai")
AGENT_MODEL_PROVIDER=
